# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.dev-server.log
*.log

# env files — .env holds real keys and must never be committed.
# .env.example is the documented template and IS committed.
.env*
!.env.example

# vercel
.vercel

# playwright MCP test artifacts (screenshots, console logs)
.playwright-mcp/

# editor-assistant scaffolding `prisma init` writes unasked (D-26 in
# DECISIONS.md) — not project code, safe to regenerate any time.
.claude/
.agents/
.windsurf/
skills-lock.json

# typescript
*.tsbuildinfo
next-env.d.ts

# Prisma client is build output, regenerated by `npm run build`.
/src/generated/prisma

# Local uploads (STORAGE_PROVIDER=local)
/public/uploads

# Reference videos/screen recordings. Anything in `public/` is served by Next
# and shipped in the deployment bundle, so a 50MB recording there is paid for
# on every deploy. Keep them outside the repo (../planeat-reference/).
*.mp4
*.mov
*.webm
